{
  "name": "orbe",
  "version": "1.8.0",
  "description": "Asistente de escritorio flotante con orbe de shaders y chat con Claude",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "humo": "electron-vite build && electron . --smoke",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "humo:real": "electron-vite build && electron . --smoke --real",
    "probar-uia": "node scripts/probar-uia.mjs",
    "iconos": "node scripts/generar-iconos.mjs",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "fondos": "electron scripts/preparar-fondos.cjs",
    "galeria": "node scripts/galeria/fotos.mjs",
    "modelo": "electron scripts/optimizar-modelo.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@rive-app/canvas": "^2.31.5",
    "dompurify": "^3.4.16",
    "katex": "^0.16.22",
    "marked": "^18.0.14",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "meshoptimizer": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "author": "Orbe",
  "license": "UNLICENSED"
}
