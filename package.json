{
  "name": "orbe",
  "version": "0.1.0",
  "description": "Asistente de escritorio flotante con orbe de shaders y chat con Claude",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "humo": "electron-vite build && electron . --smoke",
    "dist": "electron-vite build && electron-builder --win",
    "humo:real": "electron-vite build && electron . --smoke --real",
    "probar-uia": "node scripts/probar-uia.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
